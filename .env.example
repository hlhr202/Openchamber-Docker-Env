# ============================================================
# openchamber-dev-env 示例环境变量
#
# 使用: cp .env.example .env 后按需修改
# .env 已被 .gitignore 忽略，不会提交；.env.example 作为模板入库
#
# docker compose 会自动读取同目录的 .env 进行变量替换
# ============================================================

# ---- SSH ----
# root 登录密码（运行期注入，优先于构建期，不写入镜像层）
ROOT_PASSWORD=changeme
# sshd 监听端口（cloudflared config 指向 localhost:22 时保持 22）
SSH_PORT=22
# auto|on: 启动 sshd；none: 不启动
SSH_MODE=auto

# ---- cloudflared ----
# auto: /root/.cloudflared/config.yml 存在则启动隧道；off: 手动运行
CLOUDFLARED_MODE=auto

# ---- Docker ----
# auto: 挂载了宿主 socket 就复用宿主 Docker，否则启动 DinD
# dind: 强制容器内 dockerd / host: 只用宿主 socket / none: 不用 Docker
DOCKER_MODE=auto
# DinD 数据目录（容器内路径）
DOCKER_DATA_ROOT=/root/.docker-data

# ---- OpenChamber ----
# UI 密码
OPENCHAMBER_UI_PASSWORD=changeme
# 绑定地址
OPENCHAMBER_HOST=0.0.0.0
